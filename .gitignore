# ==============================================================================
# Astro-Agent Monorepo .gitignore
# ==============================================================================

# ─────────────────────────────────────────────
# Environment — secrets (API keys) must never be committed
# Copy .env.example → .env and fill in your GEMINI_API_KEY
# ─────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─────────────────────────────────────────────
# Python (api/ & other/eco_downloader/)
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
wheels/
.venv/
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ─────────────────────────────────────────────
# Bun / Node.js (ui/)
# ─────────────────────────────────────────────
node_modules/
*.tgz
bun.lock

# UI build output
ui/dist/

# Code coverage
coverage/
*.lcov

# Caches
.eslintcache
.cache
*.tsbuildinfo

# Logs
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─────────────────────────────────────────────
# Non-deployable directories
# ─────────────────────────────────────────────
docs/
other/

# ─────────────────────────────────────────────
# Temporary / working files in api/
# ─────────────────────────────────────────────
api/all_files.txt
api/all_sorted.txt
api/processed_files.txt
api/processed_sorted.txt
api/processed_files.md
api/upload_output.json

# ─────────────────────────────────────────────
# IDE & Editor
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─────────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─────────────────────────────────────────────
# Docker (runtime artifacts, not config)
# ─────────────────────────────────────────────
.docker/

# ─────────────────────────────────────────────
# Gemini / AI Agent helpers
# ─────────────────────────────────────────────
.gemini/
.agent/
CLAUDE.md
AGENT.md
ASSIGNMENT.md

api/data/